{
  "name": "wp-dev",
  "version": "1.0.0",
  "description": "Modern WordPress theme boilerplate (Gulp 5 + ESBuild + Dart Sass + BrowserSync + Vanilla JS).",
  "main": "gulpfile.js",
  "license": "ISC",
  "author": "Thomas Fleury",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development gulp watch",
    "build": "NODE_ENV=production gulp build",
    "sass": "gulp sass",
    "js": "gulp js",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "lint:css": "stylelint \"src/blocks/**/*.sass\"",
    "lint:css:fix": "stylelint \"src/blocks/**/*.sass\" --fix",
    "lint:mobile-first": "node scripts/lint-no-breakpoint-max.js",
    "lint:dup": "jscpd",
    "lint": "npm run lint:css && npm run lint:mobile-first && npm run lint:dup",
    "test": "playwright test",
    "test:report": "playwright show-report",
    "prepare": "cd .. && husky wp-dev/.husky || true"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "autoprefixer": "^10.4.13",
    "browser-sync": "^3.0.4",
    "cssnano": "^5.1.14",
    "dotenv": "^17.3.1",
    "esbuild": "^0.27.3",
    "gulp": "^5.0.1",
    "gulp-dart-sass": "^1.1.0",
    "gulp-inject": "^5.0.5",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^9.0.1",
    "gulp-pug": "^5.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-svg-sprite": "^2.0.1",
    "husky": "^9.1.7",
    "jscpd": "^5.0.10",
    "postcss-import": "^16.1.1",
    "postcss-sass": "^0.5.0",
    "sass": "^1.97.3",
    "stylelint": "^17.4.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "hamburgers": "^1.2.1",
    "muuri": "^0.9.5",
    "swiper": "^12.1.2"
  }
}
